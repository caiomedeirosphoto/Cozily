rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function myEmail() { return request.auth.token.email.lower(); }
    // E-mail confirmado: Google e link por e-mail já vêm confirmados; cadastro com senha precisa clicar no link.
    function verified() { return request.auth.token.email_verified == true; }
    function casaPath(casaId) { return /databases/$(database)/documents/casas/$(casaId); }
    // Quem pode mexer numa casa: o dono (id da conta), a conta original do nosso-ap,
    // ou qualquer e-mail CONFIRMADO que esteja na lista "membros" da casa.
    function isMember(casaId) {
      return signedIn() && (
        request.auth.uid == casaId
        || (verified() && casaId == 'nosso-ap' && myEmail() == 'caiodanielmedeiros1597@gmail.com')
        || (verified() && exists(casaPath(casaId)) && myEmail() in get(casaPath(casaId)).data.get('membros', []))
        || (verified() && exists(meuConvite()) && get(meuConvite()).data.casaId == casaId)
      );
    }
    function meuConvite() { return /databases/$(database)/documents/convites/$(myEmail()); }
    // Entrar pelo link do WhatsApp: na mesma gravação, a pessoa marca o código como usado por ela
    // e cria o próprio convite apontando pra casa do código. Só funciona com código válido e não usado.
    function entrouPeloLink(email) {
      let d = request.resource.data;
      let c = /databases/$(database)/documents/codigos/$(d.codigo);
      return signedIn() && verified() && myEmail() == email
        && d.keys().hasOnly(['casaId', 'de', 'em', 'codigo'])
        && d.codigo is string && exists(c)
        && !('usadoPor' in get(c).data)
        && get(c).data.casaId == d.casaId
        && getAfter(c).data.usadoPor == myEmail();
    }
    // Fotos: só imagem e com tamanho limitado (o app já reduz antes de subir).
    function fotoOk() {
      return request.resource.data.keys().hasOnly(['data', 'itemId'])
        && request.resource.data.data is string
        && request.resource.data.data.size() < 900000
        && request.resource.data.data.matches('^data:image/(jpeg|png|webp);base64,.*');
    }

    // Teste grátis de 7 dias: depois disso a casa fica só pra ver até o acesso ser liberado (pagamento).
    // A casa original (nosso-ap) é grátis pra sempre. "acesso" quem grava é o servidor (pagamento da Kiwify).
    function liberada(casaId) {
      let a = /databases/$(database)/documents/acesso/$(casaId);
      let t = /databases/$(database)/documents/testes/$(casaId);
      return casaId == 'nosso-ap'
        || (exists(a) && get(a).data.get('pago', false) == true)
        || (exists(t) && request.time.toMillis() < get(t).data.em + 7 * 86400000);
    }
    // Pode ver e apagar sempre; criar e mudar só com a casa liberada.
    match /casas/{casaId} {
      allow read, write: if isMember(casaId);
      match /itens/{id} { allow read, delete: if isMember(casaId); allow create, update: if isMember(casaId) && liberada(casaId); }
      match /movs/{id} { allow read, delete: if isMember(casaId); allow create, update: if isMember(casaId) && liberada(casaId); }
      match /compras/{id} { allow read, delete: if isMember(casaId); allow create, update: if isMember(casaId) && liberada(casaId); }
      match /mercado/{id} { allow read, delete: if isMember(casaId); allow create, update: if isMember(casaId) && liberada(casaId); }
      // Atividade da casa ("Mirielly marcou Geladeira como comprado"): quem é da casa lê e apaga;
      // cada um só grava em nome do próprio e-mail, e ninguém edita o que já foi gravado.
      match /atividade/{id} {
        allow read, delete: if isMember(casaId);
        allow create: if isMember(casaId) && liberada(casaId)
          && request.resource.data.keys().hasOnly(['acao', 'quem', 'email', 'em', 'alvo', 'itemId', 'valor', 'extra'])
          && request.resource.data.acao is string && request.resource.data.acao.size() <= 20
          && request.resource.data.quem is string && request.resource.data.quem.size() <= 60
          && request.resource.data.email == myEmail()
          && request.resource.data.em is int
          && request.resource.data.get('alvo', '') is string && request.resource.data.get('alvo', '').size() <= 120
          && request.resource.data.get('itemId', '') is string && request.resource.data.get('itemId', '').size() <= 200
          && request.resource.data.get('valor', 0) is number
          && request.resource.data.get('extra', '') is string && request.resource.data.get('extra', '').size() <= 80;
        allow update: if false;
      }
      match /fotos/{id} {
        allow read, delete: if isMember(casaId);
        allow create, update: if isMember(casaId) && liberada(casaId) && fotoOk();
      }
    }

    // Início do teste grátis: cada conta grava uma vez, com a hora de agora. Ninguém muda nem apaga.
    match /testes/{uid} {
      allow get: if signedIn() && (request.auth.uid == uid || isMember(uid));
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['em'])
        && request.resource.data.em is int
        && request.resource.data.em > request.time.toMillis() - 600000
        && request.resource.data.em < request.time.toMillis() + 600000;
      allow update, delete: if false;
    }
    // Acesso liberado (pago): só o servidor grava, quem é da casa lê.
    match /acesso/{casaId} { allow get: if isMember(casaId); allow write: if false; }
    // Pagamento de quem ainda não criou conta: só o servidor mexe.
    match /pagamentos/{email} { allow read, write: if false; }

    // Convites: quem é da casa convida; o convidado (com e-mail confirmado) lê o próprio convite.
    // Ninguém consegue trocar um convite que já existe pra apontar pra outra casa.
    match /convites/{email} {
      allow read: if signedIn() && verified() && myEmail() == email;
      allow create: if isMember(request.resource.data.casaId) || entrouPeloLink(email);
      allow update: if (isMember(resource.data.casaId) && isMember(request.resource.data.casaId)) || entrouPeloLink(email);
      allow delete: if isMember(resource.data.casaId) || (signedIn() && myEmail() == email);
    }

    // Link de convite (WhatsApp): qualquer um com o código lê (pra ver quem chamou), ninguém lista.
    // Vale 7 dias e serve pra uma pessoa só.
    match /codigos/{code} {
      allow get: if true;
      allow list: if false;
      allow create: if isMember(request.resource.data.casaId)
        && code.size() >= 16 && code.size() <= 40
        && request.resource.data.keys().hasOnly(['casaId', 'de', 'casa', 'nome', 'rel', 'em', 'exp'])
        && request.resource.data.nome is string && request.resource.data.nome.size() <= 40
        && request.resource.data.rel is string && request.resource.data.rel.size() <= 30
        && request.resource.data.exp is int
        && request.resource.data.exp <= request.time.toMillis() + 8 * 86400000;
      allow update: if signedIn() && verified()
        && !('usadoPor' in resource.data)
        && request.time.toMillis() < resource.data.exp
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['usadoPor', 'usadoEm'])
        && request.resource.data.usadoPor == myEmail();
      allow delete: if isMember(resource.data.casaId);
    }

    // Lista de presentes: página pública (convidado não faz login).
    match /listas/{slug} {
      allow read: if true;
      allow create: if isMember(request.resource.data.casaId);
      allow update: if isMember(resource.data.casaId) && request.resource.data.casaId == resource.data.casaId;
      allow delete: if isMember(resource.data.casaId);

      // Reserva de presente: qualquer um cria, ninguém sobrescreve; só a casa libera.
      match /reservas/{itemId} {
        allow read: if true;
        allow create: if request.resource.data.keys().hasOnly(['nome', 'em'])
          && request.resource.data.nome is string
          && request.resource.data.nome.size() > 0 && request.resource.data.nome.size() <= 60
          && request.resource.data.em is number
          && itemId.size() <= 200;
        allow update: if false;
        allow delete: if isMember(get(/databases/$(database)/documents/listas/$(slug)).data.casaId);
      }
    }

    // Registro de erros: o app só grava (sem conteúdo da lista); só o dono do app lê e apaga.
    match /erros/{id} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['msg', 'stack', 'onde', 'v', 'rota', 'ua', 'uid', 'em'])
        && request.resource.data.msg is string && request.resource.data.msg.size() <= 500
        && request.resource.data.stack is string && request.resource.data.stack.size() <= 2000
        && request.resource.data.onde is string && request.resource.data.onde.size() <= 60
        && request.resource.data.v is string && request.resource.data.v.size() <= 40
        && request.resource.data.rota is string && request.resource.data.rota.size() <= 100
        && request.resource.data.ua is string && request.resource.data.ua.size() <= 200
        && request.resource.data.uid == request.auth.uid
        && request.resource.data.em is int;
      allow read, delete: if signedIn() && verified() && myEmail() == 'caiodanielmedeiros1597@gmail.com';
      allow update: if false;
    }

    // Ofertas e cupons: o app só lê. Quem escreve é o robô (servidor), que não passa por estas regras.
    match /ofertas/{id} { allow read: if signedIn(); allow write: if false; }
    match /cupons/{id} { allow read: if signedIn(); allow write: if false; }

    // ---------- Painel de ofertas (painel.cozily.com.br) ----------
    // Só as duas contas criadas à mão no Firebase entram. Troque pelos códigos (UID) das contas,
    // que aparecem em Authentication → Usuários, na coluna "UID do usuário".
    function painelAdmin() {
      return signedIn() && request.auth.uid in ['UID_DO_CAIO', 'UID_DA_MIRI'];
    }
    match /painel/{doc} {
      allow read: if painelAdmin();
      // o painel só muda as regras do robô; o status quem grava é o robô
      allow write: if painelAdmin() && doc == 'config'
        && request.resource.data.keys().hasOnly(['descontoMin', 'imperdivelMin', 'notaMin', 'avisosPorDia', 'lojas', 'pausado', 'atualizadoEm', 'por'])
        && request.resource.data.get('descontoMin', 5) is number
        && request.resource.data.get('imperdivelMin', 15) is number
        && request.resource.data.get('notaMin', 4.5) is number;
    }
    match /painelHist/{id} { allow read: if painelAdmin(); allow write: if false; }
    match /painelBloqueados/{id} {
      allow read, delete: if painelAdmin();
      allow create, update: if painelAdmin() && request.resource.data.keys().hasOnly(['nome', 'loja', 'em', 'por']);
    }
    match /painelComandos/{id} {
      allow read: if painelAdmin();
      allow create: if painelAdmin() && request.resource.data.keys().hasOnly(['acao', 'em', 'por'])
        && request.resource.data.acao in ['rodar', 'checar', 'comissoes'];
      allow update, delete: if false;
    }
    match /precos/{id} { allow read, write: if false; }
  }
}
